{
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "npx tsc && esbuild src/graph-editor-script.ts --bundle --minify --sourcemap --outfile=dist/graph-editor-script.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write *.js *.md src/**/*.ts tests/**/*.ts",
    "format:check": "prettier --check *.js *.md src/**/*.ts tests/**/*.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "force-graph": "^1.51.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
